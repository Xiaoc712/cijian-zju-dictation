<view class="screen theme-{{themeMode}} {{stageMode ? 'stage-mode' : ''}} {{keyboardShown ? 'keyboard-mode' : ''}} {{shortStage ? 'short-stage' : ''}}">
  <scroll-view wx:if="{{!stageMode}}" class="page-scroll" scroll-y="{{!memorizeSwipeDragging}}" enhanced="{{true}}" bounces="{{false}}" scroll-into-view="{{bodyAnchor}}" bindscrolltolower="onPageScrollLower" lower-threshold="120"><view class="page-content" id="{{bodyAnchor}}">
  <view class="topbar"><view class="brand"><image class="brand-logo" src="/assets/logo.png" mode="aspectFit" /><text class="brand-name">词间默写</text></view><view class="sync status-{{status}}" bindtap="syncNow"><text class="sync-dot"></text><text>{{statusLabel}}</text></view></view>
  <view class="loading" wx:if="{{!ready}}"><image class="welcome-logo" src="/assets/logo.png" mode="aspectFit" /><text class="loading-title">词间默写</text></view>
  <block wx:else>
    <view class="notice" wx:if="{{storageError}}">{{cloudEnabled ? '本地备份暂时无法保存，请检查设备存储空间并保持联网。' : '学习记录暂时无法保存，请检查设备存储空间，并及时导出备份。'}}</view>
    <view wx:if="{{page === 'practice'}}" class="practice-page">
      <view class="intro"><view class="hero">把每一词，<text class="hero-soft">学得更笃定。</text></view></view>
      <view class="overview card"><view><text class="stat-number">{{masteredCount}}</text><text class="stat-label">已斩熟词</text></view><view><text class="stat-number">{{wrongCount}}</text><text class="stat-label">待复习</text></view><view><text class="stat-number">{{stats.correct}}</text><text class="stat-label">本轮答对</text></view><view><text class="stat-number">{{progress}}<text class="percent">%</text></text><text class="stat-label">本轮进度</text></view></view>
      <view class="practice-layout"><view class="main-column"><view class="books"><view class="section-heading"><text>我的词书</text><text class="muted small">三册原词库</text></view><button class="settings-entry" bindtap="toggleSettings"><text class="settings-entry-icon">⚙</text><view><text class="settings-entry-title">练习设置</text></view><text class="settings-entry-arrow">›</text></button><view class="book-grid"><view wx:for="{{books}}" wx:key="id" class="book-card {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectBook"><view class="book-cover cover-{{item.index}}">Aa</view><view><text class="book-title">{{item.label}}</text><text class="book-count">{{item.count}} 个词条</text></view><text wx:if="{{item.selected}}" class="book-check">✓</text></view></view></view>
        <view class="practice-card card">
          <view class="question-meta"><text class="mode-badge">{{modeLabel}}</text></view>
          <view class="question-area complete-area" wx:if="{{finished}}"><view class="complete-icon">✓</view><text class="question">这一轮，你又向前了一步。</text><text class="question-description">答对 {{stats.correct}} · 答错 {{stats.wrong}} · 跳过 {{stats.skipped}} · 已斩 {{stats.mastered}}</text></view>
          <view class="question-area idle-area" wx:else><text class="question">让熟悉的单词，
越来越多。</text></view>
          <view class="idle-actions"><button class="primary" data-review="{{review}}" bindtap="begin">{{finished ? '再练一轮' : '开始这一轮'}} →</button><button wx:if="{{finished}}" class="secondary" disabled="{{!canPrevious}}" bindtap="previous">↑ 回看上一词</button><button wx:else class="secondary" bindtap="toggleSettings">调整练习</button></view>
          <view wx:if="{{canUndo}}" class="practice-bottom"><button class="link" bindtap="undoCut">↶ 撤销斩词</button></view>
        </view>
        <view class="round-stats"><text>• 答对 {{stats.correct}}</text><text>• 答错 {{stats.wrong}}</text><text>• 跳过 {{stats.skipped}}</text><text>• 已斩 {{stats.mastered}}</text></view>
        <view class="section-heading"><text>最近的学习足迹</text><button class="link" data-page="account" bindtap="changePage">查看全部 ›</button></view><view class="recent-list card" wx:if="{{recent.length}}"><view wx:for="{{recent}}" wx:key="id" class="recent-row"><text class="result-dot result-{{item.kind}}">{{item.kind === 'correct' ? '✓' : item.kind === 'wrong' ? '×' : item.kind === 'mastered' ? '✂' : '↶'}}</text><text class="recent-english">{{item.english}}</text><text class="result-text">{{item.label}}</text></view></view><view class="empty-recent" wx:else>你的每次练习，都会在这里留下足迹。</view>
      </view><view class="tablet-note card"><text class="note-title">不必记住一切，
只需比昨天多一点。</text><button class="primary" bindtap="toggleSettings">安排这一轮练习 →</button><button class="link" bindtap="showHelp">使用帮助</button></view></view>
    </view>
    <view wx:elif="{{page === 'memorize'}}" class="memorize-page">
      <view class="intro"><view class="hero">先记住，再写下来。</view></view>
      <view class="card memory-settings"><view class="section-heading"><text>选择词书与单元</text><text class="muted small">{{memorizeTotal}} 个词条</text></view>
        <view class="book-options"><button wx:for="{{memorizeBooks}}" wx:key="id" class="{{item.selected ? 'selected' : ''}}" data-key="book" data-value="{{item.id}}" bindtap="selectMemorize">{{item.label}}</button></view>
        <picker range="{{memorizeUnits}}" range-key="title" value="{{memorizeUnitIndex}}" bindchange="selectMemorizeUnit"><view class="memory-unit"><text>当前单元</text><text>{{memorizeUnitTitle}} ⌄</text></view></picker>
        <text class="field-label">单词显示</text><view class="segmented memory-modes"><button class="{{memorizeMode === 'chinese' ? 'selected' : ''}}" data-key="mode" data-value="chinese" bindtap="selectMemorize">显示中文</button><button class="{{memorizeMode === 'english' ? 'selected' : ''}}" data-key="mode" data-value="english" bindtap="selectMemorize">显示英文</button><button class="{{memorizeMode === 'both' ? 'selected' : ''}}" data-key="mode" data-value="both" bindtap="selectMemorize">中英显示</button></view>
        <text class="field-label">单词排序</text><view class="segmented memory-orders"><button class="{{memorizeOrder === 'sequential' ? 'selected' : ''}}" data-key="order" data-value="sequential" bindtap="selectMemorize">顺序</button><button class="{{memorizeOrder === 'random' ? 'selected' : ''}}" data-key="order" data-value="random" bindtap="selectMemorize">乱序</button><button class="{{memorizeOrder === 'proficiency' ? 'selected' : ''}}" data-key="order" data-value="proficiency" bindtap="selectMemorize">标记排序</button></view>
      </view>
      <view class="memory-tools"><button class="memory-clear" bindtap="clearMemorizeMarks">清除标记</button></view>
      <view class="memory-column-heading"><text>英文</text><text>中文释义</text></view>
      <view class="memory-swipe" wx:for="{{memorizeRows}}" wx:key="id">
        <view class="memory-swipe-actions" aria-hidden="{{memorizeSwipeId !== item.id}}">
          <view class="memory-action memory-decrease" aria-role="button" aria-label="标记减一" hover-class="memory-action-active" data-id="{{item.id}}" data-delta="-1" bindtap="markMemorize"><text class="memory-action-icon">−</text><text class="memory-action-label">标记-1</text></view>
          <view class="memory-action memory-novice" aria-role="button" aria-label="加入生词本" aria-pressed="{{item.novice}}" hover-class="memory-action-active" data-id="{{item.id}}" bindtap="addMemorizeNovice"><text class="memory-action-icon">{{item.novice ? '★' : '☆'}}</text><text class="memory-action-label">生词</text></view>
          <view class="memory-action memory-master" aria-role="button" aria-label="斩词并加入熟词库" hover-class="memory-action-active" data-id="{{item.id}}" bindtap="cutMemorize"><text class="memory-action-icon">✂</text><text class="memory-action-label">斩</text></view>
        </view>
        <view class="memory-card {{memorizeSwipeDragging && memorizeSwipeId === item.id ? 'memory-dragging' : ''}}" style="transform:translateX({{memorizeSwipeId === item.id ? memorizeSwipeOffset : 0}}px)" data-id="{{item.id}}" bindtap="revealMemorize" bindtouchstart="onMemSwipeStart" bindtouchmove="onMemSwipeMove" bindtouchend="onMemSwipeEnd" bindtouchcancel="closeMemorizeSwipe">
          <text wx:if="{{item.score > 0}}" class="memory-mark">{{item.score}}</text>
          <view class="memory-row"><text class="memory-number">{{item.number}}</text>
            <view class="memory-cell memory-english">
              <view class="memory-content {{item.showEnglish ? '' : 'memory-concealed'}}" aria-hidden="{{!item.showEnglish}}">
                <view class="memory-word" style="font-size:{{item.englishFontSize}}px"><text wx:for="{{item.englishTokens}}" wx:for-item="part" wx:key="id" class="memory-word-token">{{part.text}}</text></view>
                <text wx:if="{{item.phonetic}}" class="memory-phonetic">{{item.phoneticLabel}} [{{item.phonetic}}]</text>
              </view>
              <view wx:if="{{!item.showEnglish}}" class="memory-cover"><text class="memory-mask">点击显示英文</text></view>
            </view>
            <view class="memory-cell memory-chinese">
              <view class="memory-content {{item.showChinese ? '' : 'memory-concealed'}}" aria-hidden="{{!item.showChinese}}"><text>{{item.chinese}}</text></view>
              <view wx:if="{{!item.showChinese}}" class="memory-cover"><text class="memory-mask">点击显示中文</text></view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{!memorizeTotal}}" class="memory-empty card"><text>这个单元的单词都已斩。</text><text class="description">可到“我的 → 熟词库”恢复，或切换其他单元。</text></view>
      <button wx:if="{{memorizeHasMore}}" class="secondary memory-more" bindtap="moreMemorize">继续显示更多词条 ↓</button>
    </view>
    <view wx:elif="{{page === 'wrong' || page === 'mastered'}}" class="library-page"><button wx:if="{{page === 'mastered'}}" class="link library-back" data-page="account" bindtap="changePage">‹ 返回我的</button><view class="library-hero"><view><text class="library-title">{{page === 'mastered' ? '已经熟悉的，放心斩掉。' : '再见一面，就更熟悉一点。'}}</text></view><view class="library-counter"><text>{{page === 'mastered' ? masteredCount : wrongCount}}</text><text>个词</text></view></view><view class="card library-card"><input class="search-input" value="{{search}}" bindinput="searchWords" placeholder="搜索英文或中文释义" placeholder-class="input-placeholder" /><button class="primary review-button" wx:if="{{page === 'wrong'}}" data-review="{{true}}" disabled="{{!wrongCount}}" bindtap="begin">复习生词 →</button><view class="library-subhead"><text>共 {{filteredCount}} 个匹配词</text><text>{{page === 'mastered' ? '可恢复测试' : '按英文去重'}}</text></view><view wx:for="{{wordRows}}" wx:key="id" class="word-row"><view class="word-info"><text class="word-english" selectable>{{item.english}}</text><text class="word-chinese">{{item.chinese}}</text><text class="word-source">{{item.book}} · {{item.unit}}</text></view><button wx:if="{{page === 'mastered'}}" class="secondary restore" data-id="{{item.id}}" bindtap="restoreWord">↶ 恢复</button><button wx:else class="cut" data-id="{{item.id}}" bindtap="cutFromList">✂ 斩</button></view><view wx:if="{{!filteredCount}}" class="empty-library"><text class="empty-symbol">{{page === 'mastered' ? '✂' : '✓'}}</text><text class="empty-title">{{search ? '没有找到匹配的词' : page === 'mastered' ? '把熟悉的词，留在这里。' : '生词本是空的，继续保持。'}}</text><text class="description">{{search ? '试试其他拼写。' : '去练一轮，一点一点积累。'}}</text><button class="primary" data-page="practice" bindtap="changePage">去练习 →</button></view><button wx:if="{{hasMore}}" class="link load-more" bindtap="loadMore">显示更多 ↓</button></view></view>
    <view wx:else class="account-page"><view class="intro"><text class="hero">{{cloudEnabled ? '换一台设备，也能接着学。' : '把每一点进步，留在这里。'}}</text></view><view class="card account-card appearance-card"><view class="section-heading"><text>外观</text></view><view class="appearance-options"><button class="appearance-option {{themeMode === 'light' ? 'appearance-selected' : ''}}" data-value="light" aria-label="浅色模式" aria-pressed="{{themeMode === 'light'}}" bindtap="selectTheme"><view class="appearance-swatch swatch-light"><view class="swatch-header"></view><view class="swatch-card"><view class="swatch-line"></view><view class="swatch-accent"></view></view></view><view class="appearance-label"><text>浅色模式</text><text class="appearance-check">{{themeMode === 'light' ? '✓' : ''}}</text></view></button><button class="appearance-option {{themeMode === 'dark' ? 'appearance-selected' : ''}}" data-value="dark" aria-label="深色模式" aria-pressed="{{themeMode === 'dark'}}" bindtap="selectTheme"><view class="appearance-swatch swatch-dark"><view class="swatch-header"></view><view class="swatch-card"><view class="swatch-line"></view><view class="swatch-accent"></view></view></view><view class="appearance-label"><text>深色模式</text><text class="appearance-check">{{themeMode === 'dark' ? '✓' : ''}}</text></view></button></view></view><view class="card account-card"><view class="section-heading"><text>{{cloudEnabled ? '微信账号 · 云端同步' : '本机保存模式'}}</text><text class="account-dot">●</text></view><text class="account-description">{{cloudEnabled ? '同一个微信账号在手机和平板打开，会同步熟词、生词、练习设置和当前进度。' : '练习进度、答案草稿、生词、熟词和设置自动保存在当前设备，退出后再打开可以继续练习。'}}</text><view class="account-sync"><view class="sync status-{{status}}" bindtap="syncNow"><text class="sync-dot"></text><text>{{statusLabel}}</text></view><button wx:if="{{cloudEnabled}}" class="link" bindtap="syncNow">立即同步</button></view><text class="muted small" wx:if="{{lastSynced}}">上次同步 {{lastSynced}}</text><view class="info-box">{{cloudEnabled ? '换设备前，请等待显示“微信云端已同步”。暂时断网时先保留在本机，重新联网后会继续上传。' : '手机和平板分别保存，不会自动同步。建议定期导出备份；清理小程序数据会删除本机学习记录。'}}</view></view><button class="account-mastered-entry" data-page="mastered" bindtap="changePage"><text class="mastered-entry-icon">✂</text><view><text class="mastered-entry-title">熟词库</text><text class="mastered-entry-note">已斩 {{masteredCount}} 词 · 查看和恢复测试</text></view><text class="settings-entry-arrow">›</text></button><view class="card account-card"><view class="section-heading"><text>学习备份</text></view><view class="backup-actions"><button class="secondary" bindtap="exportBackup">↓ 导出备份</button><button class="secondary" bindtap="importBackup">↑ 导入备份</button></view></view><view class="card account-card"><view class="section-heading"><text>使用帮助</text></view><button class="link" bindtap="showHelp">查看使用帮助 →</button></view><view class="card account-card"><view class="section-heading"><text>最近学习记录</text><text class="muted small">最近 100 条</text></view><view class="history-row" wx:for="{{history}}" wx:key="id"><text class="result-dot result-{{item.kind}}">{{item.kind === 'correct' ? '✓' : item.kind === 'wrong' ? '×' : item.kind === 'mastered' ? '✂' : '↶'}}</text><view><text class="recent-english">{{item.english}}</text><text class="history-time">{{item.time}}</text><text wx:if="{{item.inputLabel}}" class="history-time">输入：{{item.inputLabel}}</text></view><text class="result-text">{{item.label}}</text></view><text wx:if="{{!history.length}}" class="description">完成一轮练习，让进步留下足迹。</text></view></view>
    <button wx:if="{{page === 'account'}}" class="memory-share secondary" open-type="share">分享给朋友</button>
    <view wx:if="{{page === 'account'}}" class="footer"><text>词间默写 · v{{appVersion}}</text><text>仅供个人学习 · 原作者 Lucent_Snow</text></view>
  </block>
  <view class="page-scroll-end" aria-hidden="true"></view></view></scroll-view>
  <view wx:if="{{stageMode}}" class="study-stage card" style="height:{{studyCardHeight}}px">
    <view class="stage-meta"><text class="mode-badge">{{modeLabel}}</text><text class="stage-counter">{{current}} / {{total}}</text><button class="stage-settings" bindtap="toggleSettings">⚙ 设置</button><button wx:if="{{keyboardShown}}" class="link stage-close" bindtap="resetKeyboard">收起 ↓</button></view>
    <scroll-view class="stage-question" scroll-y="{{true}}" enhanced="{{true}}" bounces="{{false}}" style="height:{{studyQuestionHeight}}px" scroll-into-view="question-{{word.id}}"><view id="question-{{word.id}}" class="stage-question-content">
      
      <text wx:if="{{word.example}}" class="stage-chinese">{{word.chinese}}</text>
      <text class="stage-prompt {{word.example ? 'stage-example' : ''}}" selectable>{{question}}</text>
      <text class="letter-hint" wx:if="{{word.firstLetter}}">首字母 {{word.firstLetter}}</text>
    </view></scroll-view>
    <scroll-view class="stage-controls" scroll-y="{{true}}" enhanced="{{true}}" bounces="{{false}}" style="height:{{studyControlsHeight}}px"><view class="stage-controls-content">
      <form class="stage-form" bindsubmit="submit"><view class="answer-row"><input name="answer" class="answer-input" value="{{answer}}" placeholder="输入英文答案…" placeholder-class="input-placeholder" bindinput="onInput" bindconfirm="confirmAnswer" bindfocus="onInputFocus" bindblur="onInputBlur" bindkeyboardheightchange="onKeyboard" focus="{{inputFocus}}" confirm-type="done" confirm-hold="{{true}}" maxlength="120" cursor-spacing="0" adjust-position="{{false}}" hold-keyboard="{{true}}" /><button class="primary submit" form-type="submit">提交</button></view></form>
      
      <view class="feedback-slot"><view wx:if="{{feedback}}" class="feedback feedback-{{feedbackKind}}">{{feedback}}</view></view>
      <view class="practice-actions"><button class="secondary" disabled="{{!canPrevious}}" bindtap="previous">↑ 上一词</button><button class="secondary" bindtap="skip">↓ 跳过</button><button class="cut" bindtap="cut">✂ 斩 · 已熟知</button></view>
      <view wx:if="{{canUndo}}" class="practice-bottom"><button class="link" bindtap="undoCut">↶ 撤销斩词</button></view>
    </view></scroll-view>
    <view class="progress-track"><view style="width:{{progress}}%"></view></view>
  </view>
  <view class="bottom-nav" style="{{stageMode ? 'top:' + studyNavTop + 'px;height:' + studyNavHeight + 'px;bottom:auto;padding-bottom:' + (studyNavPadding + 3) + 'px' : 'min-height:' + (64 + pageSafeBottom) + 'px;padding-bottom:' + (8 + pageSafeBottom) + 'px'}}"><view wx:for="{{tabs}}" wx:key="id" class="nav-item {{page === item.id || (page === 'mastered' && item.id === 'account') ? 'is-active' : ''}}" data-page="{{item.id}}" bindtap="changePage"><text class="nav-mark">{{item.mark}}</text><text>{{item.label}}</text></view></view>
  <view class="sheet-mask" wx:if="{{settingsOpen}}" bindtap="closeSettings"><view class="sheet" catchtap="ignoreTap"><view class="sheet-heading"><text>安排这一轮练习</text><button class="link close" bindtap="closeSettings">×</button></view><scroll-view class="sheet-scroll" scroll-y><text class="field-label">选择词书</text><view class="book-options"><button wx:for="{{books}}" wx:key="id" class="{{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectBook">{{item.label}}</button></view><view class="section-heading"><text class="field-label">练习单元（可多选）</text><button class="link" bindtap="toggleUnits">{{allUnits ? '取消全选' : '全选单元'}}</button></view><view class="unit-grid"><button wx:for="{{units}}" wx:key="id" class="{{item.chosen ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="selectUnit">{{item.chosen ? '✓ ' : ''}}{{item.title}}<text class="unit-count">{{item.count}} 词条</text></button></view><text class="field-label">练习内容</text><view class="segmented"><button class="{{preferences.content === 'all' ? 'selected' : ''}}" data-key="content" data-value="all" bindtap="selectOption">全部</button><button class="{{preferences.content === 'words' ? 'selected' : ''}}" data-key="content" data-value="words" bindtap="selectOption">单词</button><button class="{{preferences.content === 'phrases' ? 'selected' : ''}}" data-key="content" data-value="phrases" bindtap="selectOption">短语</button></view><text class="field-label">出题顺序</text><view class="segmented"><button class="{{preferences.order === 'sequential' ? 'selected' : ''}}" data-key="order" data-value="sequential" bindtap="selectOption">顺序练习</button><button class="{{preferences.order === 'random' ? 'selected' : ''}}" data-key="order" data-value="random" bindtap="selectOption">随机练习</button></view><text class="field-label">作答模式</text><view class="segmented"><button class="{{preferences.mode === 'word' ? 'selected' : ''}}" data-key="mode" data-value="word" bindtap="selectOption">单词默写</button><button class="{{preferences.mode === 'example' ? 'selected' : ''}}" data-key="mode" data-value="example" bindtap="selectOption">例句填空</button></view><view class="switch-row"><text>首字母提示</text><switch checked="{{preferences.firstLetter}}" data-key="firstLetter" bindchange="switchOption" color="{{themeMode === 'dark' ? '#a99af5' : '#6555d8'}}" /></view><view class="switch-row"><text>答错后重试</text><switch checked="{{preferences.retry}}" data-key="retry" bindchange="switchOption" color="{{themeMode === 'dark' ? '#a99af5' : '#6555d8'}}" /></view><view class="switch-row"><text>答题音效</text><switch checked="{{soundEnabled}}" bindchange="onSoundChange" color="{{themeMode === 'dark' ? '#a99af5' : '#6555d8'}}" /></view></scroll-view><button class="primary sheet-start" bindtap="begin">{{active ? '开始新一轮' : '开始这一轮'}} →</button></view></view>
  <view class="sheet-mask" wx:if="{{helpOpen}}" bindtap="closeHelp"><view class="sheet help-sheet" catchtap="ignoreTap"><view class="sheet-heading"><text>使用帮助</text><button class="link close" bindtap="closeHelp">×</button></view><scroll-view class="sheet-scroll" scroll-y><view class="help-item"><text class="help-title">01 · 放心忽略空格</text><text>答案忽略大小写和全部空白，短语可以连写；不填答案或只输入空白后提交，按答错处理并加入生词；拼写与标点仍需正确。例句填空只填单词原形。</text></view><view class="help-item"><text class="help-title">02 · 回看，也可以跳过</text><text>上一词保留草稿；随机模式也沿本轮固定顺序回退。跳过不会清掉已有生词，重答不重复累计。</text></view><view class="help-item"><text class="help-title">03 · 熟悉了，就斩掉</text><text>熟词按英文匹配，不同释义也一起排除。可撤销最近一次斩词，或在“我的 → 熟词库”恢复。</text></view><view class="help-item"><text class="help-title">04 · 答对了，再告别生词</text><text>复习时答对才移除，退出和跳过都会保留。可以在设置里开启答错后重试。</text></view><view class="help-item"><text class="help-title">{{cloudEnabled ? '05 · 同一微信账号，接着学' : '05 · 本机保存，随时接着学'}}</text><text>{{cloudEnabled ? '手机和平板同步熟词、生词与进度。换设备前等“微信云端已同步”。与网页版之间可通过备份导入迁移记录。' : '退出后再打开，会继续当前练习。手机和平板各自保存，可通过导入、导出备份迁移熟词和生词；导入不会替换当前练习进度。'}}</text></view><view class="help-item"><text class="help-title">06 · 背诵与标记</text><text>选择显示中文、显示英文或中英显示；点击卡片先显示遮住的答案，再次点击标记加一，多次点击可累加。右滑可标记减一、加入生词本或斩词。标记默认 0，最低 0；每张卡片独立计数。标记排序按数量从多到少，同数量随机；增减标记只更新数字，保持当前顺序，再点“标记排序”才重新排列。右上角仅显示非零标记。“清除标记”清零当前单元全部未斩词条，包含尚未加载的部分，保持当前顺序。</text></view><view class="help-item"><text class="help-title">07 · 练习设置与备份</text><text>Unit 1-1、1-2 是同一单元的不同分组，可一起选择。设置用于下一轮，当前顺序保持不变。将 JSON 备份发送到微信聊天，再从“我的 → 导入备份”选择文件；导入合并熟词、生词和标记，分数采用较新记录，不替换当前练习进度。</text></view></scroll-view></view></view>
</view>
