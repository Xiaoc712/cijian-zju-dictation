/* Native page scrolling is disabled; normal pages scroll inside page-scroll. */
.screen{position:fixed;top:0;right:0;bottom:0;left:0;width:100%;display:flex;flex-direction:column;overflow:hidden}
.page-scroll{width:100%;height:0;min-height:0;flex:1}
.page-scroll-end{height:24px;width:100%;flex-shrink:0}
.study-stage{position:fixed;top:8px;left:12px;right:12px;max-width:730px;margin:0 auto;padding:8px 14px 0;overflow:hidden;z-index:21}
.stage-meta{height:32px;display:flex;align-items:center;gap:6px;justify-content:space-between;overflow:hidden}
.stage-meta .mode-badge{flex:1;min-width:0;font-size:10px;padding:4px 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.stage-counter{flex:none;font-size:11px;color:var(--muted);white-space:nowrap;margin-left:auto}
.stage-settings{flex:none;width:68px;min-height:30px;height:30px;background:var(--accent-soft);border-color:var(--accent-border);color:var(--accent-strong);font-size:10px;padding:0 7px;white-space:nowrap}
.stage-close{flex:none;width:42px;min-height:30px;height:30px;font-size:10px;white-space:nowrap;padding:0 2px}
.stage-question{margin:3px 0;overflow:hidden}
.stage-question-content{padding:10px 2px 14px;text-align:center}

.stage-prompt{display:block;font-size:24px;font-weight:600;line-height:1.5;white-space:pre-wrap;word-break:break-word}
.stage-example{font-family:Georgia,serif;font-size:20px;font-weight:400}
.stage-chinese{display:block;font-size:17px;line-height:1.7;color:var(--text);margin-bottom:10px}
.stage-question .letter-hint{display:inline-block;margin-top:10px}
.short-stage .stage-question-content{padding-top:2px}
.short-stage .stage-prompt{font-size:20px}
.stage-controls{overflow:hidden}
.stage-controls-content{padding:12px 2px 20px}
.study-stage .stage-form{display:block;width:100%;margin:0;padding:0}
.study-stage .answer-row{display:flex;width:100%;flex-direction:column;align-items:stretch;gap:0}
.study-stage .answer-input{width:100%;height:50px;font-size:17px;padding:0 14px}
.study-stage .submit{width:100%;height:48px;min-height:48px;align-self:stretch;margin:14px 0 0;font-size:16px}
.study-stage .feedback-slot{min-height:0;padding-top:12px}
.study-stage .feedback{font-size:11px;line-height:1.6;padding:6px 9px}
.study-stage .practice-actions{margin-top:18px;gap:10px}
.study-stage .practice-actions button{flex:1;min-height:42px;font-size:11px;padding:0 10px}
.study-stage .practice-bottom{min-height:40px;margin-top:8px}
.study-stage .progress-track{height:2px;margin:0 -14px}
.study-stage .progress-track>view{height:2px}
.stage-mode .bottom-nav{position:fixed;min-height:0;margin:0;padding:3px 10px;border-radius:0;max-width:none;left:0;right:0;transform:none}
.stage-mode .nav-item{min-height:28px;gap:1px;font-size:9px}
.stage-mode .nav-mark{font-size:18px;line-height:18px}
.settings-entry{width:100%;justify-content:flex-start;gap:12px;min-height:66px;background:var(--accent-soft);border:1px solid var(--accent-border);color:var(--accent-strong);padding:12px 15px;margin:9px 0 13px;text-align:left;border-radius:13px}
.settings-entry-icon{font-size:25px}
.settings-entry>view{flex:1}
.settings-entry-title{display:block;font-size:15px;font-weight:600}

.settings-entry-arrow{font-size:26px}

.unit-grid button{flex-direction:column;gap:4px;min-height:53px;font-size:11px}
.unit-count{font-size:9px;opacity:.7}
.memory-settings{padding:17px;border-radius:15px;margin-bottom:20px}
.memory-unit{display:flex;justify-content:space-between;align-items:center;background:var(--surface-alt);border:1px solid var(--border);border-radius:9px;min-height:46px;padding:0 12px;margin-top:12px;font-size:12px;color:var(--accent-strong)}
.memory-unit>text:last-child{font-weight:500;color:var(--text)}
.memory-column-heading{display:flex;padding:0 20px 10px 43px;font-size:11px;color:var(--muted)}
.memory-column-heading>text{flex:1}
.memory-row{display:flex;align-items:stretch;gap:6px;background:var(--surface);border:1px solid var(--border);border-radius:13px;overflow:hidden;margin-bottom:11px;min-height:92px;padding:8px 8px 8px 0}
.memory-number{width:23px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:var(--accent-soft);color:var(--muted);font-size:10px;margin:-8px 0}
.memory-cell{position:relative;flex:1 1 0;min-width:0;padding:8px 6px;display:flex;flex-direction:column;justify-content:center;border-radius:8px;word-break:break-word;line-height:1.8}
.memory-english{font-size:18px;color:var(--ink)}
.memory-chinese{font-size:13px;color:var(--text)}
.memory-cover{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:8px 6px;border-radius:8px;background:var(--mask);border:1px dashed var(--mask-border);text-align:center}
.memory-mask{font-size:12px;color:var(--mask-ink)}

.memory-more{width:100%;min-height:44px;margin-top:16px}


.memory-swipe{position:relative;overflow:hidden;border-radius:13px;margin-bottom:12px;background:var(--surface-alt)}
.memory-swipe-actions{position:absolute;top:0;left:0;bottom:0;width:192px;display:flex;align-items:stretch}
.memory-action{width:64px;min-width:64px;max-width:64px;flex:0 0 64px;height:100%;padding:0;border:0;border-radius:0;box-sizing:border-box;color:var(--on-accent);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:7px;font-size:11px;font-weight:600;line-height:18px}
.memory-action+.memory-action{border-left:1px solid rgba(255,255,255,.28)}
.memory-action-icon{display:block;flex:none;font-size:26px;font-weight:400;line-height:32px;text-align:center}
.memory-action-label{display:block;width:100%;text-align:center;font-size:11px;font-weight:600;line-height:18px;white-space:nowrap;letter-spacing:.2px}
.memory-decrease{background:linear-gradient(160deg,var(--action-plus-top),var(--action-plus-bottom))}
.memory-novice{background:linear-gradient(160deg,var(--action-minus-top),var(--action-minus-bottom))}
.memory-master{background:linear-gradient(160deg,var(--action-cut-top),var(--action-cut-bottom));color:var(--action-cut-ink)}

.memory-card{position:relative;z-index:1;background:var(--surface);border:0;border-radius:13px;transition:transform .18s ease-out;will-change:transform}
.memory-dragging{transition:none}
.memory-card .memory-row{border:0;border-radius:0;margin:0;padding:24px 8px 8px 0;background:transparent}
.memory-card .memory-number{margin:-24px 0 -8px}
.memory-tools{display:flex;justify-content:flex-end;margin:-8px 0 12px}
.memory-share{width:100%;min-height:44px;margin-top:17px}
.memory-clear{min-height:36px;padding:0 13px;font-size:12px;background:var(--surface);color:var(--accent-strong);border:1px solid var(--border);border-radius:9px}
.memory-mark{position:absolute;top:5px;right:11px;z-index:2;font-size:11px;font-weight:600;line-height:14px;color:var(--muted);font-variant-numeric:tabular-nums}
.memory-action-active{opacity:.8}
.memory-empty{padding:35px 20px;text-align:center;font-size:15px;color:var(--accent-strong)}
.account-mastered-entry{width:100%;min-height:85px;text-align:left;justify-content:flex-start;gap:14px;padding:17px 18px;margin-bottom:17px;background:var(--positive-soft);border-color:var(--positive-border);color:var(--positive);border-radius:15px}
.account-mastered-entry>view{flex:1}
.mastered-entry-icon{font-size:28px}
.mastered-entry-title{display:block;font-size:16px;font-weight:600}
.mastered-entry-note{display:block;font-size:11px;line-height:1.8;font-weight:400;margin-top:4px;color:var(--positive)}
.library-back{justify-content:flex-start;font-size:13px;margin-top:10px}
.appearance-options{display:flex;gap:12px}
.appearance-options .appearance-option{width:calc((100% - 12px)/2);min-width:0;flex:1;flex-direction:column;gap:12px;padding:12px;border:1px solid var(--border);border-radius:12px;background:var(--surface-alt);color:var(--text)}
.appearance-options .appearance-selected{border-color:var(--accent);background:var(--accent-soft);color:var(--accent-strong);box-shadow:0 0 0 1px var(--accent)}
.appearance-swatch{width:100%;height:78px;overflow:hidden;border-radius:8px;padding:10px;background:var(--preview-canvas);border:1px solid var(--preview-border)}
.swatch-light{--preview-canvas:#f7f8fc;--preview-surface:#ffffff;--preview-border:#e1e5ef;--preview-line:#d8dce9;--preview-accent:#6555d8}
.swatch-dark{--preview-canvas:#101116;--preview-surface:#1b1d25;--preview-border:#363a49;--preview-line:#555b70;--preview-accent:#a99af5}
.swatch-header{width:38%;height:5px;margin-bottom:9px;background:var(--preview-accent);border-radius:3px}
.swatch-card{padding:9px;background:var(--preview-surface);border:1px solid var(--preview-border);border-radius:6px}
.swatch-line{width:67%;height:4px;background:var(--preview-line);border-radius:3px}
.swatch-accent{width:42%;height:7px;margin-top:7px;background:var(--preview-accent);border-radius:3px}
.appearance-label{width:100%;display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:13px;font-weight:500;line-height:20px}
.appearance-check{min-width:14px;font-size:15px;font-weight:600;color:var(--accent)}
@media(min-width:800px){.memorize-page{max-width:850px;margin:0 auto}.memory-row{min-height:105px}.memory-english{font-size:22px}.memory-chinese{font-size:15px}.memory-settings{padding:23px}.study-stage{left:20px;right:20px}}

.memory-content{width:100%;min-width:0}
.memory-concealed{visibility:hidden}
.memory-word{display:flex;flex-wrap:wrap;gap:0 4px;line-height:1.4;align-items:center;word-break:normal;overflow-wrap:normal}
.memory-word-token{flex:none;white-space:nowrap;word-break:normal;overflow-wrap:normal}
.memory-phonetic{display:block;margin-top:5px;font-size:11px;line-height:1.5;color:var(--muted);word-break:break-word}
