/* Shared semantic colors for every page, sheet and input. */
.screen {
  --canvas: #f7f8fc;
  --surface: #ffffff;
  --surface-alt: #f3f4fb;
  --input: #fbfcff;
  --border: #e1e5ef;
  --border-soft: #edf0f6;
  --ink: #242738;
  --text: #596178;
  --muted: #656d83;
  --accent: #6052d6;
  --accent-strong: #5142b8;
  --accent-fill: #6555d8;
  --accent-soft: #efedff;
  --accent-border: #d1caf6;
  --on-accent: #ffffff;
  --positive: #367957;
  --positive-soft: #edf7f1;
  --positive-border: #d5e8dc;
  --negative: #b94960;
  --negative-soft: #fff0f2;
  --warning: #8f691e;
  --warning-soft: #fff5e5;
  --warning-border: #f0dfb9;
  --disabled: #eff0f6;
  --mask: #f1f2fa;
  --mask-ink: #656d83;
  --mask-border: #e0e2ef;
  --overlay: #15162966;
  --shadow: #39345f0a;
  --accent-shadow: #6555d81a;
  --cover-blue: #596da3;
  --cover-purple: #7865ad;
  --cover-violet: #79638f;
  --action-plus-top: #526bb7;
  --action-plus-bottom: #465aa3;
  --action-minus-top: #8a5eac;
  --action-minus-bottom: #6f468f;
  --action-cut-top: #ddbb76;
  --action-cut-bottom: #cba65d;
  --action-cut-ink: #4b3516;
}
.screen.theme-dark {
  --canvas: #101116;
  --surface: #1b1d25;
  --surface-alt: #242631;
  --input: #171920;
  --border: #363a49;
  --border-soft: #2b2e3a;
  --ink: #f1f2f8;
  --text: #c5c9db;
  --muted: #a0a8be;
  --accent: #b4a8ff;
  --accent-strong: #c6baff;
  --accent-fill: #705dd9;
  --accent-soft: #302b49;
  --accent-border: #564b7c;
  --on-accent: #ffffff;
  --positive: #8bd5ad;
  --positive-soft: #1b342b;
  --positive-border: #305341;
  --negative: #f0a0af;
  --negative-soft: #3b242e;
  --warning: #e7c17a;
  --warning-soft: #3a3020;
  --warning-border: #645235;
  --disabled: #292c37;
  --mask: #424650;
  --mask-ink: #e8ebf3;
  --mask-border: #69707f;
  --overlay: #00000099;
  --shadow: #00000033;
  --accent-shadow: #00000033;
  --cover-blue: #425888;
  --cover-purple: #64538f;
  --cover-violet: #665077;
  --action-plus-top: #35518b;
  --action-plus-bottom: #283e6d;
  --action-minus-top: #69448a;
  --action-minus-bottom: #503369;
  --action-cut-top: #78562b;
  --action-cut-bottom: #5e421f;
  --action-cut-ink: #ffe1a1;
}
.screen{background:var(--canvas);color:var(--ink)}
